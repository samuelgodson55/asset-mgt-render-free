# Protects the /v1/* ingestion and management API.
# Legacy compatibility key. Prefer the two scoped keys below for new deployments.
ERRORBEACON_INGEST_API_KEY=replace-with-a-long-random-ingest-key
ERRORBEACON_ADMIN_API_KEY=replace-with-a-long-random-admin-key

# Telegram BotFather token and destination chat/group ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional Telegram forum topic/thread ID.
TELEGRAM_THREAD_ID=

# Optional AI-assisted root-cause analysis.
# Leave blank to run without AI and avoid AI API costs.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://errorbeacon.local

# Alert noise controls.
MAX_ALERTS_PER_MINUTE=30
DEDUP_SECONDS=60
LOG_LEVEL=INFO
DATA_DIR=/data
SPIKE_THRESHOLD=10
SPIKE_WINDOW_SECONDS=300
ALERT_QUEUE_SIZE=1000
ALERT_WORKERS=3
TELEGRAM_POLLING=true
TELEGRAM_POLL_SECONDS=20
# Leave WAL for local/VM disks. ACA sets DELETE because /data is Azure Files.
SQLITE_JOURNAL_MODE=WAL

# Controlled chaos/smoke-test incidents are persisted always. Set false in production
# to keep deliberate chaos-test events out of Telegram while retaining them for audit/debugging.
CHAOS_TEST_ALERTS=false

# AI analysis queue: serialized by default to avoid provider burst/rate-limit failures
AI_WORKERS=1
AI_RETRIES=1
AI_RETRY_BASE_SECONDS=30
AI_MAX_INCIDENT_RETRIES=3
AI_QUEUE_SIZE=500

# Secondary email uses the application's EXISTING email notification transport.
# Do not create a second provider/account for ErrorBeacon. Reuse these exact
# application values and ADMIN_NOTIFICATION_EMAILS.
NOTIFICATIONS_ENABLED=true
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM_EMAIL=
BREVO_API_KEY=
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAILS=
ERRORBEACON_EMAIL_FALLBACK_ENABLED=true
ERRORBEACON_EMAIL_FALLBACK_AFTER_ATTEMPTS=3
ERRORBEACON_EMAIL_FALLBACK_AFTER_SECONDS=300
ERRORBEACON_EMAIL_FALLBACK_RETRIES=3
ERRORBEACON_RETENTION_DAYS=90
ERRORBEACON_RETENTION_INTERVAL_SECONDS=3600
ERRORBEACON_AUTO_STALE_DAYS=30
ERRORBEACON_DB_WARN_MB=4096
ERRORBEACON_CLEAN_MAX_DEPTH=10
ERRORBEACON_CLEAN_MAX_ITEMS=100
ERRORBEACON_DIGEST_ENABLED=true
ERRORBEACON_DIGEST_INTERVAL_HOURS=24
ERRORBEACON_STARTUP_SELF_TEST=false
TEST_ALERTS_PER_MINUTE=3

# Security hardening
ERRORBEACON_ENABLE_DOCS=false
ERRORBEACON_MAX_REQUEST_BODY_BYTES=131072
ERRORBEACON_ADMIN_AUTH_FAILURES_PER_MINUTE=10
# Only enable when ErrorBeacon is behind a trusted proxy that overwrites X-Real-IP.
# Keep false for public Render deployments.
ERRORBEACON_TRUST_PROXY_HEADERS=false
