# =============================================================================
# .env.azure.example
# -----------------------------------------------------------------------------
# NOT read by docker-compose.yml or any Azure tooling directly -- this is a
# reference only, showing exactly what value each .env.example key gets on
# Azure Container Apps. infra/main.bicep sets all of these for you (see its
# `sharedEnv`/`sharedSecrets` variables); nothing here needs to be pasted
# anywhere. Use this file to understand WHY a value differs from local
# Docker Compose or Render, and as a quick reference when debugging a
# deployed environment with `az containerapp show`.
#
# See DEPLOYMENT.md's "Azure Container Apps Production Deployment" section
# for the full explanation of each substitution below.
# =============================================================================

# --- Environment -----------------------------------------------------------
ENVIRONMENT=production

# --- PostgreSQL --------------------------------------------------------------
# Local Docker Compose: postgresql://admin:...@db:5432/asset_db
# Azure:                Azure Database for PostgreSQL Flexible Server, TLS
# required -- note the added ?sslmode=require and the *.postgres.database
# .azure.com hostname (infra/main.bicep's `postgres` resource).
DATABASE_URL=postgresql://snipeitadmin:<password>@<server>.postgres.database.azure.com:5432/asset_db?sslmode=require

# --- Redis ---------------------------------------------------------------------
# Local Docker Compose: redis://redis:6379/0 (no auth, no TLS -- private
# Compose network only)
# Azure: Azure Cache for Redis, TLS-only (port 6380, rediss:// scheme, access
# key as the password) -- see infra/main.bicep's `redis` resource.
REDIS_URL=rediss://:<access-key>@<name>.redis.cache.windows.net:6380/0

# --- nginx reverse proxy (frontend container app) ---------------------------
# Local Docker Compose resolves "backend" via Docker's embedded DNS (127.0.0.11).
# Azure Container Apps resolves the SAME short name -- "backend" -- via its
# own built-in service discovery (http://<container-app-name>), because the
# backend Container App is literally named "backend". Zero nginx config
# changes needed -- see nginx/default.conf.template's BACKEND_HOST/BACKEND_PORT
# usage and infra/main.bicep's `frontendApp` resource.
PORT=80
BACKEND_HOST=backend
BACKEND_PORT=80
# RESOLVER_IP: left UNSET on Azure -- nginx/docker-entrypoint.d/15-detect-resolver-ip.sh
# auto-detects the correct internal resolver from the container's own
# /etc/resolv.conf at boot, same as it does on Render.

# --- CORS ------------------------------------------------------------------------
# Locked to the frontend Container App's own public FQDN (or your custom
# domain, if configured) -- see infra/main.bicep's `backendApp` CORS_ORIGINS value.
CORS_ORIGINS=https://frontend.<env-unique-id>.<region>.azurecontainerapps.io

# --- Secrets (Key Vault, never plain env vars) ------------------------------
# JWT_SECRET_KEY, SUPER_ADMIN_PASSWORD, and SMTP_PASSWORD are NOT set as
# plain Container Apps environment variables -- they're stored in Azure Key
# Vault and referenced via a `secretRef` backed by the shared managed
# identity (see infra/main.bicep's `secrets`/`sharedSecrets`). Nothing
# secret ever appears in `az containerapp show` output, GitHub Actions logs,
# or this repo.

# --- Startup behavior ------------------------------------------------------------
# AUTO_INIT_DB / AUTO_SEED_DEMO_DATA are FALSE on every container app -- see
# the "migrate" Container Apps Job (infra/main.bicep) and DEPLOYMENT.md's
# promotion pipeline for how `alembic upgrade head` runs instead, as an
# explicit one-shot step before each rollout.
AUTO_INIT_DB=false
AUTO_SEED_DEMO_DATA=false

# --- Structured logging -----------------------------------------------------------
# LOG_FORMAT=json flows straight into Log Analytics' ContainerAppConsoleLogs_CL
# table as structured fields -- see DEPLOYMENT.md's Monitoring section for
# the KQL queries this enables.
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Backups -----------------------------------------------------------------------
# BACKUP_DIR points at the SAME path as before (/app/backups), but the
# volume backing it is now an Azure Files share (infra/main.bicep's
# `backupStorage`) instead of a local Docker named volume -- survives
# container recreation/rescheduling exactly like the Compose volume did,
# and is additionally covered by Postgres Flexible Server's own automated
# backups (see infra/main.bicep's `postgres.backup` block).
BACKUP_DIR=/app/backups
EXPORT_RESULT_DIR=/app/export_results
