# =============================================================================
# .env.azure.example
# -----------------------------------------------------------------------------
# NOT read by docker-compose.yml or any Azure tooling directly -- this is a
# reference only, showing exactly what value each .env.example key gets on
# Azure Container Apps under the COST-OPTIMIZED architecture: `frontend`
# (frontend/Dockerfile, static build + reverse proxy), `backend` (FastAPI +
# embedded Celery worker/beat), `redis` (Redis container) -- all three
# Container Apps -- plus Azure Database for PostgreSQL Flexible Server
# (`postgresServer`, a managed service, NOT a Container App). See
# infra/main.bicep's top-of-file comment for the full reasoning, especially
# "WHY POSTGRES IS A MANAGED SERVICE" for why Postgres specifically can't be
# a fourth Container App on Azure Files. infra/main.bicep sets all of these
# for you; nothing here needs to be pasted anywhere -- use this file to
# understand WHY a value differs from local Docker Compose or Render, and as
# a quick reference when debugging a deployed environment with `az
# containerapp show` / `az postgres flexible-server show`.
#
# See DEPLOYMENT.md's "Azure Container Apps Production Deployment
# (Cost-Optimized)" section for the full explanation.
# =============================================================================

# --- Environment -----------------------------------------------------------
ENVIRONMENT=production

# --- PostgreSQL --------------------------------------------------------------
# Local Docker Compose: postgresql://admin:...@db:5432/asset_db
# Azure:                Azure Database for PostgreSQL Flexible Server -- a
# managed service, NOT a Container App (an earlier version of this file ran
# Postgres as a `db` Container App on an Azure Files volume; that fails at
# `initdb` time with "chmod: Operation not permitted" because Azure Files
# doesn't support the POSIX permission bits Postgres requires on its data
# directory -- see infra/main.bicep's top-of-file comment for the full
# story). Reached over its own public FQDN
# (`<server>.postgres.database.azure.com`), NOT the short in-environment DNS
# name used for `redis`/`backend` -- Flexible Server lives outside the
# Container Apps environment entirely. `sslmode=require` because that
# connection crosses the public internet/Azure backbone (still fully
# encrypted -- Flexible Server enforces TLS server-side regardless of this
# flag; the firewall, not network isolation, is what keeps this server
# closed to everything except Azure's own backbone and, optionally, your own
# IP -- see infra/main.bicep's `postgresAdminClientIp` parameter). Backups
# and point-in-time restore are handled automatically by the managed
# service now, in addition to this app's own optional `ENABLE_AUTO_BACKUP`
# pg_dump job.
DATABASE_URL=postgresql://snipeit:<password>@<server-name>.postgres.database.azure.com:5432/asset_db?sslmode=require

# --- Redis ---------------------------------------------------------------------
# Local Docker Compose: redis://redis:6379/0 (no auth, no TLS -- private
# Compose network only)
# Azure: Redis running as its OWN Container App named `redis`, internal-only
# TCP ingress, reachable over the Container Apps environment's short
# in-environment DNS name -- unlike Postgres (see above), Redis stays a
# Container App here since it never touches Azure Files persistence (see
# infra/main.bicep's top comment). Password-protected via --requirepass but
# no TLS (not needed -- internal-only network). No persistent volume -- an
# in-memory cache/broker that resets on restart, same trade-off as Render's
# free Key Value tier. Still required even in this split-services shape:
# it's what makes `backend` safe to autoscale past 1 replica (shared
# Celery broker, cross-replica rate limiter, backup leader lock -- see
# infra/main.bicep's top-of-file comment).
REDIS_URL=redis://:<password>@redis:6379/0

# --- `backend` (FastAPI + embedded Celery worker/beat) ----------------------
# Unlike the single-combined-`app` version of this architecture, `backend`
# is now API-only -- it does NOT serve the frontend (SERVE_FRONTEND is unset
# here; `frontend` handles that). Internal-only ingress: only `frontend` and
# `migrate` can reach it, never the public internet directly.
RUN_EMBEDDED_WORKER=true
PORT=8000

# --- `frontend` (frontend/Dockerfile, UNMODIFIED from local Docker Compose) ----
# Serves the static build AND reverse-proxies /api/* to `backend` over the
# Container Apps environment's internal DNS -- exactly like local Docker
# Compose's nginx container. This is what lets frontend/js/api.js keep its
# hardcoded relative API_URL = '/api' and cookie-based auth
# (credentials:'include') completely unchanged: the browser only ever talks
# to `frontend`'s single public origin.
PORT=80
BACKEND_HOST=backend
BACKEND_PORT=8000
# RESOLVER_IP intentionally unset -- auto-detected at container boot from
# Container Apps' own /etc/resolv.conf, see
# nginx/docker-entrypoint.d/15-detect-resolver-ip.sh.

# --- CORS ------------------------------------------------------------------------
# Set on `backend` as defense-in-depth (locked to `frontend`'s own public
# FQDN, or your custom domain if configured) even though normal browser
# traffic never calls `backend` directly -- see infra/main.bicep's
# `backendApp` resource, CORS_ORIGINS value.
CORS_ORIGINS=https://frontend.<env-unique-id>.<region>.azurecontainerapps.io

# --- API docs gating (must match on BOTH `backend` and `frontend`) --------
# `backend`'s own docs_url/redoc_url/openapi_url gating (config.py) AND
# nginx's matching passthrough route (nginx/default.conf.template) both
# read ENABLE_API_DOCS -- infra/main.bicep's `enableApiDocs` parameter sets
# this identically on both Container Apps in one place, so they can't drift
# out of sync with each other.
ENABLE_API_DOCS=false

# --- Distributed tracing (Operations & Observability requirement #4) ----------
# Local Docker Compose: OTEL_EXPORTER_OTLP_ENDPOINT pointing at the local
# `jaeger` service (docker-compose.yml, opt-in via `--profile tracing`).
# Azure: infra/main.bicep's `otelAzureMonitorEnabled` param (default false --
# see that param's own @description for the ~$0-unless-you-actually-use-it
# reasoning: it reuses the Log Analytics workspace `logAnalytics` already
# provisions for container console logs, is billed purely on data actually
# ingested, and Application Insights' free tier -- see README.md's
# "Distributed Tracing" section -- covers this app's traffic at any
# realistic small-deployment scale). Setting it `true` provisions a
# `Microsoft.Insights/components` resource and wires its connection string
# onto `backend` as the Container Apps SECRET
# APPLICATIONINSIGHTS_CONNECTION_STRING below -- you never paste a
# connection string anywhere yourself; infra/main.bicep's outputs give you
# the resource name to look it up in the Portal instead, if you want it for
# something else too (e.g. the `az monitor app-insights` CLI).
#
# OTEL_ENABLED still has to be explicitly turned on too (via the deploy
# workflow's `vars.OTEL_ENABLED` repo variable -- see
# .github/workflows/infra-deploy.yml) -- `otelAzureMonitorEnabled=true`
# alone only provisions the Application Insights resource, it does not by
# itself start instrumenting anything (matches this app's existing
# provision-vs-enable split elsewhere, e.g. `alertEmailAddress` provisions
# alert rules but ENABLE_AUTO_BACKUP separately controls whether there's
# ever anything for them to alert on).
OTEL_ENABLED=true
OTEL_SERVICE_NAME=snipeit-lite-backend
# Left empty/unused here on purpose -- the Application Insights path below
# is what infra/main.bicep actually wires up for you on Azure. Only set
# this too (or instead) if you specifically want a SECOND, generic OTLP
# destination alongside/instead of Application Insights (self-hosted
# otel-collector, Grafana Cloud, Honeycomb, ...) -- see
# infra/main.bicep's `otelExporterOtlpEndpoint`/`otelExporterOtlpHeaders`
# params for the deploy-time equivalent of these two.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLE_RATIO=1.0
# Set as a Container Apps SECRET by infra/main.bicep when
# otelAzureMonitorEnabled=true -- shown here only as a reference for what
# it looks like; you never type this value in yourself (see comment
# above).
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=<guid>;IngestionEndpoint=https://<region>.in.applicationinsights.azure.com/

# --- Secrets (Container Apps secrets, never plain env vars) ----------------
# JWT_SECRET_KEY, ROOT_ADMIN_BOOTSTRAP_PASSWORD, DATABASE_URL, REDIS_URL,
# SMTP_PASSWORD, OTEL_EXPORTER_OTLP_HEADERS, and
# APPLICATIONINSIGHTS_CONNECTION_STRING are set as Container Apps `secrets`
# on `backend`/`migrate` (encrypted at rest, never shown in `az
# containerapp show`'s env var list or GitHub Actions logs) and referenced
# via `secretRef` -- not Key Vault. `frontend` carries no secrets at all --
# it never touches the database, Redis, JWTs, SMTP, or tracing exporters
# directly.

# --- Container registry ------------------------------------------------------
# No Azure Container Registry. TWO images now, both pulled straight from
# Docker Hub: <you>/snipeit-lite-backend and <you>/snipeit-lite-frontend.
# Default: both PUBLIC repos, so no registry credentials exist anywhere in
# this deployment. If you'd rather keep either private, set dockerHubUsername
# + dockerHubToken (a Docker Hub Personal Access Token) when deploying
# infra/main.bicep -- but note Docker Hub's FREE plan includes only ONE
# private repo, so making BOTH private requires a paid Docker Hub plan.
# `redis` still pulls its official image directly from Docker Hub too --
# redis:7-alpine, no registry of your own involved. Postgres is NOT a
# container image at all in this architecture -- it's Azure Database for
# PostgreSQL Flexible Server, a managed PaaS resource with no image to pull
# or registry to configure.

# --- Startup behavior ------------------------------------------------------------
AUTO_INIT_DB=false
# Migrations run as an explicit Container Apps Job (`migrate`, using
# `backend`'s own image, `alembic upgrade head`) triggered by the CI/CD
# pipeline BEFORE the new backend image rolls out -- never on container
# boot. Jobs bill only for the seconds they actually run.

# --- Backups -----------------------------------------------------------------
# ENABLE_AUTO_BACKUP=true still works exactly as documented in .env.example --
# backups now write to an Azure Files share (backup-data) mounted at
# /app/backups on `backend`, so they survive a `backend` container restart
# or redeploy. This is now a CONVENIENCE layer on top of Flexible Server's
# own automated backups + point-in-time restore (on by default,
# `postgresBackupRetentionDays` in infra/main.bicep, no app config needed) --
# not the only backup story, unlike the old self-hosted `db` Container App.
# Still turn on BACKUP_GDRIVE_ENABLED if you want an off-box copy independent
# of Azure entirely (e.g. to restore into a different provider later).
