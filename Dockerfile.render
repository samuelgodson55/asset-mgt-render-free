# =============================================================================
# Dockerfile.render
# -----------------------------------------------------------------------------
# Builds ONE image containing the FastAPI backend, the static frontend, AND
# (optionally, via RUN_EMBEDDED_WORKER) the Celery worker/beat process --
# everything docker-compose.yml normally splits across THREE containers
# (backend, worker, frontend/nginx), combined into a single deployable unit.
#
# WHY THIS FILE EXISTS
# Render's Free instance type only supports Web Services, Postgres, and Key
# Value (Redis) -- Private Services and Background Workers are NOT available
# on the Free plan at all (see render.yaml's top-of-file comment). The
# original multi-service design (a private backend + a private worker + a
# public nginx frontend) needs THREE non-free services to run on Render,
# which costs real money. This Dockerfile instead produces a single image
# that can run entirely on ONE free web service:
#   - FastAPI serves the API under /api/* (see backend/main.py)
#   - FastAPI ALSO serves the static frontend directly, via
#     SERVE_FRONTEND=true (see backend/main.py's StaticFiles mount) --
#     replacing nginx's job for this deployment shape.
#   - render-start.sh optionally launches the Celery worker+beat process
#     alongside uvicorn, in the same container -- replacing the separate
#     `worker` service's job.
#
# This is a Render/free-tier-specific alternative to backend/Dockerfile
# (used by docker-compose.yml and any multi-service deployment) -- it does
# NOT replace that file. See README.md's "Deploying on Render's Free Plan"
# section for the full picture, including this approach's tradeoffs
# (everything spins down and restarts together, no horizontal scaling).
#
# CHOOSING A FRONTEND: LEGACY vs. REACT
# Unlike frontend/Dockerfile (the multi-service image, which builds
# EXACTLY ONE of the two frontends per image via `--target`), this image
# builds BOTH the legacy multi-page site and the React "Ledger" SPA every
# time and ships them side by side (see stages 1 and 2 below) -- which one
# is actually SERVED is a runtime choice, `FRONTEND_VARIANT` (config.py /
# render.yaml), not a build one. Render's Blueprint spec (render.yaml) has
# no field for passing a custom Docker build arg through at all, so a
# build-time `--target`-style choice would mean either hand-editing this
# file or maintaining two separate render.yaml services just to switch
# frontends -- baking both in and picking at container start with a plain
# environment variable means switching is a redeploy (a restart, since
# nothing about the image itself changed), not a rebuild. The extra build
# time/image size from always building both is small next to that
# convenience for a personal/demo-scale free-tier deployment. See
# config.py's FRONTEND_VARIANT docstring and main.py's "STATIC FRONTEND"
# section for how the choice is actually applied at runtime.
#
# Four stages:
#   1. "frontend-build" -- processes frontend/ (legacy site) per BUILD_ARG
#      (defaults to "production" here, since Render is a production deploy
#      target: JS ships minified + obfuscated, same as the nginx-fronted
#      deployment shape gets -- see build-frontend/build.js). render.yaml
#      can override this via a build arg if you ever want a staging
#      service on "local" or "development" instead.
#   2. "frontend-app-build" -- builds frontend-app/ (the React "Ledger"
#      SPA) with Vite, mirroring frontend/Dockerfile's own
#      frontend-app-build stage.
#   3. "backend-builder" -- installs Python deps into a venv.
#   4. final stage -- copies ONLY the venv + BOTH processed frontends +
#      app code into a fresh base. No pip cache, no node_modules, no build
#      metadata of any kind ends up in the image that's actually deployed.
# =============================================================================

# ---------------------------------------------------------------------------
# Stage 1/4: frontend-build -- see build-frontend/build.js for what each
# BUILD_ENV value does. Defaults to "production" (minified + obfuscated)
# since this Dockerfile's whole purpose is a production deployment target.
#
# node:24-slim (Debian/glibc), not -alpine -- same musl-vs-glibc npm
# native-binding issue documented on frontend/Dockerfile's matching stage
# applies here too (see that file's own comment for the full root cause);
# kept on the same base as stage 2 below for consistency even though this
# particular stage doesn't touch Vite/Rolldown itself.
# ---------------------------------------------------------------------------
FROM node:24-slim AS frontend-build

ARG BUILD_ENV=production
ENV BUILD_ENV=${BUILD_ENV}

WORKDIR /build
COPY build-frontend/package.json build-frontend/package-lock.json* /build/build-frontend/
RUN cd build-frontend && npm ci --no-audit --no-fund
COPY build-frontend/build.js /build/build-frontend/build.js
COPY frontend/ /build/frontend-src/
RUN node build-frontend/build.js /build/frontend-src /build/frontend-out

# ---------------------------------------------------------------------------
# Stage 2/4: frontend-app-build -- builds the React/Vite "Ledger" SPA
# (frontend-app/) into static assets. Same reasoning/shape as
# frontend/Dockerfile's own frontend-app-build stage (its own toolchain,
# own lockfile, kept as a separate stage so it doesn't bust
# frontend-build's Docker layer cache above or vice versa). Not affected
# by BUILD_ENV -- Vite's own `npm run build` always does a real production
# build (minified, bundled, content-hashed filenames).
#
# node:24-slim, NOT -alpine -- this is the stage that actually runs
# Vite/Rolldown and hits the musl native-binding error
# ("Cannot find module '@rolldown/binding-linux-x64-musl'", npm/cli#4828)
# if built on Alpine. See frontend/Dockerfile's matching stage for the
# full root-cause writeup; fixed the exact same way here.
# ---------------------------------------------------------------------------
FROM node:24-slim AS frontend-app-build

WORKDIR /build
COPY frontend-app/package.json frontend-app/package-lock.json* /build/
RUN npm ci --no-audit --no-fund && npm cache clean --force
COPY frontend-app/ /build/
RUN npm run build

# ---------------------------------------------------------------------------
# Stage 3/4: backend-builder -- installs Python deps into a venv so stage
# 4 can copy just that directory, without pip's own cache/build metadata.
# ---------------------------------------------------------------------------
FROM python:3.11-slim AS backend-builder

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Same requirements.txt the backend/worker images use -- celery/redis are
# already listed there since docker-compose.yml's `worker` service depends
# on them too, so no separate install step is needed for the embedded
# worker case.
COPY backend/requirements.txt /app/
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --default-timeout=100 -r requirements.txt

# ---------------------------------------------------------------------------
# Stage 4/4: runtime -- this is the image that actually ships to Render.
# ---------------------------------------------------------------------------
FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"

# postgresql-client provides pg_dump/psql -- required by
# services/backup_service.py (database backup/restore). Same reasoning as
# backend/Dockerfile's identical block.
RUN apt-get update && \
    apt-get install -y --no-install-recommends postgresql-client && \
    rm -rf /var/lib/apt/lists/*

# Installed Python deps, copied from backend-builder -- no pip cache/build
# metadata included.
COPY --from=backend-builder /opt/venv /opt/venv

# Backend application code.
COPY backend/ /app/

# BOTH processed frontends, side by side -- see this file's own
# "CHOOSING A FRONTEND" section above for why both ship unconditionally.
# Destination paths match config.py's FRONTEND_DIR/FRONTEND_REACT_DIR
# defaults ("/app/frontend" / "/app/frontend-react"); FRONTEND_VARIANT
# (runtime env var) picks which one main.py's StaticFiles mount actually
# serves -- see that setting's own docstring.
COPY --from=frontend-build /build/frontend-out/ /app/frontend/
COPY --from=frontend-app-build /build/dist/ /app/frontend-react/

COPY render-start.sh /app/render-start.sh
RUN chmod +x /app/render-start.sh

# Precompile every backend .py file (and every installed dependency) to
# .pyc at build time instead of paying that cost on the container's first
# request/import -- meaningfully shortens cold start, which matters more
# here than on docker-compose's backend/worker services since a Render
# Free instance spins ALL the way down after 15 minutes idle and has to
# cold-start again on the next request (see render.yaml's comment).
RUN python -m compileall -q /app /opt/venv

# SECURITY: run as a dedicated, unprivileged user -- same reasoning as
# backend/Dockerfile's identical block.
RUN useradd --create-home --shell /bin/bash appuser && chown -R appuser:appuser /app
USER appuser

# These are the free-tier single-service defaults for THIS image. They can
# still be overridden via render.yaml's envVars (which they are, for
# clarity) -- ENV here just means the image is self-describing/runnable
# on its own without extra flags, e.g. for local testing:
#   docker build -f Dockerfile.render -t snipeit-lite-render .
#   docker run -p 8000:8000 -e DATABASE_URL=... -e REDIS_URL=... snipeit-lite-render
ENV SERVE_FRONTEND=true
ENV RUN_EMBEDDED_WORKER=true

CMD ["/app/render-start.sh"]

