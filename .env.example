# =============================================================================
# .env.example
# -----------------------------------------------------------------------------
# TEMPLATE ONLY -- this file IS committed to git and contains NO real secrets,
# just placeholder values so you know what to fill in.
#
# HOW TO USE:
#   1. Copy this file to a new file literally named ".env" in this same
#      folder:   cp .env.example .env
#   2. Replace every placeholder value below with your own real secret.
#   3. Never commit ".env" -- it's already listed in .gitignore for you.
#
# docker-compose.yml automatically reads ".env" and substitutes any
# ${VARIABLE_NAME} it finds using these values. The backend container also
# receives these same values as environment variables, which
# backend/config.py (Pydantic Settings) reads into the app at startup.
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------
# Used by BOTH the "db" service (to initialize the database) and the
# "backend" service (to build its DATABASE_URL below) -- keeping them as
# separate variables referenced in two places means they can never drift
# out of sync with each other.
# --- Environment ---------------------------------------------------------
# One of: "local", "development" (default), or "production".
#
# Backend (backend/config.py): only "production" is treated specially --
# the backend refuses to start if JWT_SECRET_KEY is still a placeholder or
# shorter than 32 characters. "local" behaves exactly like "development"
# for this check.
#
# Frontend (frontend/Dockerfile + build-frontend/build.js): this value is also
# passed in as the frontend image's BUILD_ENV build arg (see
# docker-compose.yml's `frontend.build.args`), and controls how
# frontend/js and frontend/*.html are processed when the image is BUILT:
#   local        -- none: raw source copied as-is (readable in DevTools,
#                    for working on this on your own PC)
#   development  -- JS minified (Terser); HTML minified (html-minifier-terser)
#   production   -- JS minified + obfuscated (Terser, then
#                    javascript-obfuscator); HTML minified (same as
#                    development -- HTML is minified, not obfuscated)
#
# Changing this value does NOT affect an already-running frontend
# container -- you must rebuild the image for it to take effect:
#   docker compose up -d --build frontend
# Watch the build output: build-frontend/build.js prints a per-file size
# report for whichever mode just ran.
ENVIRONMENT=development

# How many uvicorn worker processes the backend starts with when
# ENVIRONMENT=production (see backend/start.sh) -- ignored for
# development/local, which always run a single worker with --reload.
# Roughly: set this to the number of CPU cores available to the container.
UVICORN_WORKERS=2

POSTGRES_USER=admin
POSTGRES_PASSWORD=change-this-to-a-long-random-password
POSTGRES_DB=asset_db

# Full SQLAlchemy connection string the backend uses to reach Postgres.
# "db" is the Docker Compose service name for the database container --
# leave it as "db" unless you rename that service in docker-compose.yml.
DATABASE_URL=postgresql://admin:change-this-to-a-long-random-password@db:5432/asset_db

# --- Redis (Celery broker + result backend for async exports) -------------
# Used by the "backend" service (to enqueue audit-ledger export jobs) and
# the "worker" service (to consume them and generate the CSV/PDF file) --
# see backend/celery_app.py and the "worker" service in docker-compose.yml.
# "redis" is the Docker Compose service name for the redis container --
# leave it as "redis" unless you rename that service too. No password by
# default since it's never reachable outside this Compose network (no
# `ports:` mapping) -- add one (redis://:<password>@redis:6379/0) if you
# ever expose Redis beyond this network.
REDIS_URL=redis://redis:6379/0
# Where finished CSV/PDF export files are written to disk (SPEED: this
# keeps large file bytes out of Redis/RAM -- see backend/tasks/
# export_tasks.py's module docstring). Must be a path both "backend" and
# "worker" mount the SAME volume at -- see docker-compose.yml's
# `export_data` volume. Leave as the default unless you've also changed
# that volume's mount path.
EXPORT_RESULT_DIR=/app/export_results

# --- JWT / Auth -----------------------------------------------------------
# MUST be a long, random, unpredictable string in any real deployment.
# Generate one with, e.g.:  python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=12

# --- Display timezone ---------------------------------------------------------
# All data is stored as UTC -- this only controls what timezone CSV/PDF
# exports (audit ledger, properties-assigned reports) render their
# timestamps in, so exported hours match what the Audit Trail already
# shows on screen (which converts UTC -> browser-local automatically).
# Must be a real IANA timezone name.
DISPLAY_TIMEZONE=Africa/Lagos

# --- CORS -------------------------------------------------------------------
# Comma-separated list of origins allowed to call the API directly. With the
# nginx reverse proxy (see nginx/default.conf.template), the browser only
# ever calls the SAME origin that served the page, so this is now mostly
# defense-in-depth rather than something you need to keep editing per
# environment.
#
# ALSO used by POST /auth/forgot-password (see backend/api/auth_api.py's
# _resolve_frontend_base_url()) as the trusted-origins allowlist a mailed
# password-reset link's base URL is checked against before being used --
# make sure this includes your real public domain(s) in any deployment
# where you want those emailed links to work.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost,http://127.0.0.1

# --- nginx reverse proxy (frontend service) ----------------------------------
# The frontend container is built from frontend/Dockerfile and serves the
# static site AND transparently proxies /api/* to the backend -- see
# nginx/default.conf.template for the full explanation. The browser never
# needs to know any of these values; only nginx does.
#
# FRONTEND_PORT: port nginx listens on INSIDE its own container. Leave at 80
#   for local Docker Compose (host access still goes through the "8080:80"
#   mapping in docker-compose.yml). On a platform that injects its own port
#   (e.g. Render sets $PORT), set this to match that platform's requirement
#   instead -- frontend/Dockerfile already defaults ENV PORT=80 as a fallback.
FRONTEND_PORT=80

# BACKEND_HOST / BACKEND_PORT: where nginx forwards /api/* requests.
#   - Local Docker Compose: leave as "backend" / 8000 (the Compose service
#     name + port from this same file's "backend" service, resolved via
#     Docker's built-in DNS).
#   - Render / cloud: set these to that environment's actual backend
#     hostname and port (e.g. your Render backend service's internal
#     hostname, or an internal load balancer address in your cloud VPC).
BACKEND_HOST=backend
BACKEND_PORT=8000

# RESOLVER_IP: the internal DNS server nginx uses to re-resolve BACKEND_HOST
# on every request (instead of caching a stale IP after a backend
# redeploy). 127.0.0.11 is Docker's own embedded DNS -- correct for local
# Docker Compose, which is why it's set explicitly below. On other
# platforms (Render, Kubernetes, ECS, ...), leave this UNSET/commented out
# instead of guessing -- nginx/docker-entrypoint.d/15-detect-resolver-ip.sh
# auto-detects the real value from the container's own /etc/resolv.conf at
# boot if it isn't set.
RESOLVER_IP=127.0.0.11

# --- API documentation exposure (SECURITY) ------------------------------------
# Controls whether /docs (Swagger UI), /redoc, and /openapi.json exist at
# all -- read by BOTH the backend (backend/config.py) and the frontend/nginx
# proxy (nginx/default.conf.template), as defense in depth; see
# config.py's ENABLE_API_DOCS docstring for the full reasoning. "true" is
# fine/convenient for local Docker Compose. Set this to "false" in any
# environment reachable from the public internet -- Render's render.yaml
# already does this for you.
ENABLE_API_DOCS=true

# --- Startup behavior (Operations & Observability) ---------------------------
# Set BOTH to "false" in a real production deployment -- see backend/config.py
# and README.md's "Database Migrations" / "Running in Production" sections.
# Leave them "true" for local docker-compose so the demo works out of the box.
AUTO_INIT_DB=true
AUTO_SEED_DEMO_DATA=true

# --- Structured logging -------------------------------------------------------
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
# LOG_FORMAT: "json" (recommended for any real deployment / log aggregator)
#             or "text" (more readable while developing locally)
# Defaults to "text" here since this file is what a local `docker compose up`
# uses -- raw JSON objects are hard to eyeball in a terminal. Azure
# (infra/main.bicep) and Render (render.yaml) both hardcode LOG_FORMAT=json
# independently of this file, so production logging is unaffected either way.
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Distributed tracing (Operations & Observability requirement #4) ----------
# OpenTelemetry -- see backend/telemetry.py's module docstring for exactly
# what this instruments (FastAPI requests, SQL queries, Celery tasks, Redis
# commands) and how it differs from the plain structured logging above.
# Off by default, matching every other opt-in flag in this file.
#
# QUICKEST WAY TO TRY IT LOCALLY -- zero external accounts needed:
#   1. OTEL_ENABLED=true below
#   2. docker compose --profile tracing up   (starts a local Jaeger UI too
#      -- see docker-compose.yml's `jaeger` service comment)
#   3. use the app for a bit, then open http://localhost:16686
# OTEL_EXPORTER_OTLP_ENDPOINT already defaults to "http://jaeger:4318" in
# docker-compose.yml -- you don't need to set it yourself for the local
# Jaeger path, only if pointing at something else (a real collector, a
# SaaS tracing backend's OTLP endpoint, ...).
#
# FOR AZURE APPLICATION INSIGHTS INSTEAD: leave OTEL_EXPORTER_OTLP_ENDPOINT
# empty and set APPLICATIONINSIGHTS_CONNECTION_STRING below instead -- see
# .env.azure.example for where to get that value and README.md's
# "Distributed Tracing" section for how to actually view traces there.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=snipeit-lite-backend
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_TRACES_SAMPLE_RATIO=1.0
# OTEL_CONSOLE_EXPORTER=false
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Single-service free-tier deployment mode (Render only) -----------------
# These two are NOT needed for local Docker Compose -- leave them unset here
# and the app behaves exactly as before (nginx serves the frontend, the
# worker container runs Celery separately). They only matter for the
# combined single-container image built from Dockerfile.render, where
# render.yaml already sets both to "true" for you. See backend/config.py's
# SERVE_FRONTEND/RUN_EMBEDDED_WORKER docstrings and README.md's "Deploying
# on Render" section for the full free-plan reasoning.
# SERVE_FRONTEND=false
# RUN_EMBEDDED_WORKER=false

# --- Login rate limiting -------------------------------------------------------
# POST /auth/login allows at most LOGIN_RATE_LIMIT_MAX attempts per
# LOGIN_RATE_LIMIT_WINDOW_SECONDS from the same client IP before returning
# HTTP 429. See backend/middleware/rate_limit.py for details/limitations.
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# --- Per-account brute-force lockout --------------------------------------------
# A SECOND, finer-grained layer on top of the IP-based limiter above: after
# ACCOUNT_LOCKOUT_MAX_ATTEMPTS consecutive wrong-password attempts against the
# SAME account, that account is locked for ACCOUNT_LOCKOUT_DURATION_MINUTES --
# regardless of which IP the attempts come from. See models.py's
# User.failed_login_attempts/locked_until docstring and
# services/auth_service.py's login() for details.
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# --- Root Administrator identity (root account) -------------------------------
# The root admin IS a row in the `users` table (exactly one), bootstrapped
# once by `alembic upgrade head` in production (see
# backend/alembic/versions/0002_bootstrap_root_admin.py) or by
# backend/database.py's seed_db() for local/dev/test. The two settings
# below are only its INITIAL identity (username/display name) -- like the
# password, they're rotatable afterward: the password through the app's
# usual change-password / admin-reset flows, and username/name/email
# through the new "Account Details" section in My Profile (super_admin
# only -- PATCH /auth/me, see backend/security.py's module docstring for
# the full rationale).
#
# SUPER_ADMIN_USERNAME/SUPER_ADMIN_NAME: the root account's INITIAL
#   identity. Set these to the same values the migration should read (see
#   ROOT_ADMIN_BOOTSTRAP_PASSWORD below) -- the migration reads these two
#   env vars directly too, so keep them in sync here. Whatever the
#   account is later rotated to in the database always wins over these at
#   runtime.
# ROOT_ADMIN_BOOTSTRAP_PASSWORD: OPTIONAL, and only ever read ONCE, by the
#   migration, the very first time it inserts the root admin row -- never
#   by the running app itself. Leave it unset and the migration will
#   generate a random password for you and print it to the migration's
#   own output exactly once (see that file's docstring); set it here if
#   you'd rather choose the initial value yourself. Either way, rotate it
#   via the app's normal Change Password flow immediately after first login,
#   and consider removing this line from your real `.env` afterward -- it's
#   never read again once the row exists.
#   local & development environments: the default password is RootAdmin123!
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_NAME="Super Admin"
ROOT_ADMIN_BOOTSTRAP_PASSWORD=

# --- "Forgot password?" self-recovery --------------------------------------
# Powers POST /auth/forgot-password / POST /auth/reset-password -- mainly
# gives the root admin (SUPER_ADMIN_USERNAME above) a real password-recovery
# path once its email has been rotated away from the migration's
# "{username}@local" placeholder to a real, reachable mailbox (see the
# Account Details section in My Profile). NOTIFICATIONS_ENABLED/SMTP_* below
# must also be configured for the reset email to actually send.
#
# How many minutes a mailed reset link stays redeemable before it expires.
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=30

# --- Email notifications (extension requests + overdue + due-soon) --------
# NOTIFICATIONS_ENABLED is the master switch. Leave it "false" for local dev
# with no mail server -- every notification is simply logged instead of sent
# (see backend/services/notification_service.py). Flip to "true" and fill in
# the SMTP_* values once you have a real mail server/provider (your own
# Postfix, SendGrid, Mailgun, AWS SES's SMTP endpoint, etc. all work -- this
# is plain SMTP, no vendor SDK) -- the default, and the only thing the VM/ACA
# deploy paths ever need.
NOTIFICATIONS_ENABLED=false
# EMAIL_PROVIDER selects the transport: "smtp" (default -- leave unset
# locally) or "brevo"/"resend" (an HTTP-API alternative, ONLY needed if
# you're deploying somewhere that blocks outbound SMTP ports 25/465/587 --
# e.g. render.yaml sets this to "brevo", since Render's Free web service
# instance type blocks those ports at the network level; see this file's
# own render.yaml counterpart and config.py's EMAIL_PROVIDER comment for
# the full story). Leave blank/unset for local dev.
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Implicit SSL for port 465, instead of STARTTLS on port 587. Set this to
# true (and SMTP_PORT=465) if your network/ISP blocks outbound 587 --
# common on residential connections. Takes priority over SMTP_USE_TLS.
SMTP_USE_SSL=false
# Must match a domain/sender your SMTP provider allows you to send as --
# also doubles as the "from" address for EMAIL_PROVIDER=brevo/resend below
# (Brevo requires this exact address to be a verified sender in your
# account first -- Brevo dashboard > Senders, Domains & Dedicated IPs).
SMTP_FROM_EMAIL=
# Only read when EMAIL_PROVIDER=brevo -- https://app.brevo.com/settings/keys/api
BREVO_API_KEY=
# Only read when EMAIL_PROVIDER=resend -- https://resend.com/api-keys
RESEND_API_KEY=
# Optional extra recipients (comma-separated) who get every overdue digest,
# every due-soon reminder digest, and every new-extension-request alert, in
# addition to Admins/Managers.
ADMIN_NOTIFICATION_EMAILS=
# What time of day (UTC) the worker checks for overdue checkouts and
# emails the digest described above -- see backend/celery_app.py's
# beat_schedule. Comma-separated hours of day (UTC, each 0-23), same
# format as BACKUP_HOURS_UTC below: "8" fires once a day at 08:00 UTC,
# "8,20" fires twice a day.
OVERDUE_DIGEST_HOURS_UTC=7
# "A reminder before something goes overdue" -- how many days ahead of its
# due_date an active checkout counts as "due soon". Drives the "Due Soon"
# dashboard banner (admin.html/manager.html), the "Due Soon" badge on
# staff.html/customer.html's My Items, AND the due-soon reminder email
# below -- one setting, applied consistently everywhere.
DUE_SOON_REMINDER_DAYS=1
# What time of day (UTC) the worker checks for checkouts about to go
# overdue and emails the reminder digest described above. Same
# comma-separated-hours format as OVERDUE_DIGEST_HOURS_UTC above -- its
# own independent schedule, e.g. lower it to "a couple of minutes from
# now" while testing locally without also changing when the overdue
# digest fires.
DUE_SOON_DIGEST_HOURS_UTC=7
# Whether the individual "your item is overdue/due soon" reminder goes to
# the checkout's own holder, IN ADDITION TO the admin digest above. Set
# to false to send ONLY the admin/manager digest (e.g. while testing SMTP
# delivery) without emailing end users. No code change needed to turn
# back on later -- just flip this to true.
SEND_INDIVIDUAL_HOLDER_REMINDERS=true

# --- Equipment Quotation self-service (staff/customer asset catalog) ------
# ISO 4217 currency code applied everywhere a price is shown or exported
# (Asset Inventory price, Quotation Catalog day-rate, Quotation PDF export).
CURRENCY_CODE=NGN
# Brand name shown across the deployment: the on-screen navbar/login
# header + browser tab title (read live from GET /config/public on every
# page load) AND the Quotation/Checkout Receipt PDF's letterhead -- one
# setting rebrands both, no frontend file edits needed.
SITE_NAME="Snipe-IT Lite"
# Whether a staff/customer account browsing the self-service Quotation
# Catalog can see each pool's available quantity + in-stock/out-of-stock
# status. Default false (recommended for production): they only see name,
# department, and price. A Manager/Admin's own Asset Inventory is always
# full-detail regardless of this flag.
CATALOG_SHOW_STOCK_TO_STAFF_CUSTOMER=false

# --- Database backups (pg_dump + optional Google Drive upload) ------------
# See backend/services/backup_service.py and README.md's "Backups" section.
# ENABLE_AUTO_BACKUP runs one gzip-compressed pg_dump at each hour listed in
# BACKUP_HOURS_UTC, inside this same process (no Celery/Redis needed).
ENABLE_AUTO_BACKUP=true
# Comma-separated hours of day (UTC, each 0-23). "3" runs once a day at
# 03:00 UTC; "3,15,21" runs three times a day instead.
BACKUP_HOURS_UTC=3
BACKUP_DIR=/app/backups
# How many local backup files to keep before deleting the oldest. NOTE:
# on Render's Free plan this container's disk is wiped on every
# restart/redeploy regardless of this setting -- enable Google Drive
# below for backups that actually survive that.
BACKUP_RETENTION_COUNT=7
# Google Drive upload (optional but recommended for production). TWO auth
# modes -- pick the one matching your Google account (see backend/config.py's
# BACKUP_GDRIVE_* docstring for the full explanation of why there are two):
#
#   MODE 1 -- personal/consumer Google account (e.g. a regular Gmail):
#     Run `python backend/scripts/gdrive_oauth_setup.py /path/to/client_secret.json`
#     once on your own machine (see that script's docstring for the ~5 min
#     Google Cloud Console setup first), then paste the 3 values it prints:
BACKUP_GDRIVE_OAUTH_CLIENT_ID=
BACKUP_GDRIVE_OAUTH_CLIENT_SECRET=
BACKUP_GDRIVE_OAUTH_REFRESH_TOKEN=
#
#   MODE 2 -- Google Workspace account with a Shared Drive (a plain service
#   account has ZERO Drive storage quota of its own, so this mode only
#   works if BACKUP_GDRIVE_FOLDER_ID below points INSIDE a Shared Drive --
#   it will fail with "storageQuotaExceeded" on a personal account or a
#   regular "My Drive" folder, which is what Mode 1 above is for):
#     Create a Google Cloud service account, download its JSON key, share a
#     folder INSIDE a Shared Drive with the service account's own
#     @...gserviceaccount.com email as an Editor, then paste the JSON key's
#     raw contents here (as one line, or use Render's "Secret File" feature
#     and point this at that file's path -- see README.md):
BACKUP_GDRIVE_CREDENTIALS_JSON=
#
# If both modes are filled in, Mode 1 (OAuth) takes priority.
BACKUP_GDRIVE_ENABLED=false
# The destination folder's ID from its Drive URL:
# https://drive.google.com/drive/folders/<THIS_PART>
# Mode 1: any regular folder in your own Drive. Mode 2: must be inside a
# Shared Drive.
BACKUP_GDRIVE_FOLDER_ID=
